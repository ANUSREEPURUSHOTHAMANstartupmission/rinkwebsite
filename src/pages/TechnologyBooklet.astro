---
import Layout from '../layouts/Layout.astro';
import Countdown from "../components/Countdown.svelte";
import Navbar from "../components/Navbar.astro";
import Navbarbottom from "../components/Navbarsub.svelte";

import Tracks from "../components/Tracks.astro";
import Videogallery from "../components/Videogallery.svelte";
import Booklet from "../components/Booklet.astro";

---

<Layout  title="LEAP | KERALA STARTUP MISSION">

    <Navbarbottom client:load></Navbarbottom>
            <div class="container pt-24 text-center min-h-screen">
                <div>
                    <h2 class="md:text-4xl text-2xl font-bold text-blue-900">Technology Booklet</h2>
                    <div class="w-full flex flex-col items-center justify-center pt-4">
                        <p class=" max-w-5xl">
                            Discover a curated list of technologies developed across Kerala’s premier research institutions.  Whether you are looking for a market ready product, a scalable prototype, or a novel scientific solution, these technologies are available for licensing, co-development, or commercialization.  
                        </p>
                    </div>
                </div>
                <div class=" pt-10">
                    <Booklet client:load></Booklet>
                </div>
                  <div class="w-full items-center justify-center flex flex-col mb-24">
                    <div class=" w-fit ">
                        <a class=" bg-yellow-400 px-4 py-3 text-white text-lg  hover:bg-yellow-500 duration-300" href="https://docs.google.com/forms/d/e/1FAIpQLScqqdwVrmogj5Fpa9A798MZm9ek6WFSS644-i8dOdB7I_ZAYg/viewform?usp=preview" target="_blank">Technology Transfer Interest Form</a>
                    </div>
               </div>
            </div>

</Layout>

<script is:inline>
  document.querySelectorAll("a.page-scroll").forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const href = anchor.getAttribute("href");
      const targetId = href.replace(/^\/?#/, "");
      const targetElement = document.getElementById(targetId);

      if (targetElement) {
        e.preventDefault();

        targetElement.scrollIntoView({ behavior: "smooth" });

        history.replaceState(null, null, window.location.pathname);
      }
    });
  });

  window.addEventListener("DOMContentLoaded", () => {
    const hash = window.location.hash;
    if (hash) {
      const targetId = hash.replace("#", "");
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        setTimeout(() => {
          targetElement.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, null, window.location.pathname);
        }, 100);
      }
    }
  });
</script>
