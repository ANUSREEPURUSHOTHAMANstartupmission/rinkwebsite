<div  class=" mx-auto items-center  justify-center text-center flex flex-col  pb-24 ">
    <div class=" mx-auto grid md:grid-cols-2 lg:grid-cols-3 grid-cols-1  gap-2 z-30 h-auto">
        {books1.map((item) => (
        <div class=" overflow-hidden  p-4 group relative">
            <img data-pdf={item.link} data-id={item.id} src={item.img} class="cursor-pointer duration-500 group-hover:scale-105">
             <div class=" absolute inset-0 flex items-center justify-center" data-pdf={item.link} data-id={item.id} src={item.img}>
                    <a data-pdf={item.link} data-id={item.id} src={item.img} class=" bg-blue-950 rounded-full p-6 w-10 h-10 flex flex-col items-center justify-center popup-videos">
                        
                        <i class="fa fa-play text-white text-xl" data-pdf={item.link} data-id={item.id} src={item.img}></i>
                    </a>
              </div>
              <p class="pt-4">{item.title}</p>
        </div>
        ))}
    </div>

   


    <div class="pt-10 container">
        <div class="grid md:grid-cols-2 grid-cols-1  h-auto">
            <div class="flex w-full lg:items-end lg:justify-end items-center justify-center">
               <div class="lg:w-3/4 w-full flex items-center justify-center">
                 {food.map((item) => (
                  <div class=" overflow-hidden  p-4 group relative">
                      <img data-pdf={item.link} data-id={item.id} src={item.img} class="cursor-pointer flex duration-500 group-hover:scale-105 items-center justify-center rounded-xl">
                      <div class=" absolute inset-0 flex items-center justify-center" data-pdf={item.link} data-id={item.id} src={item.img}>
                          <a data-pdf={item.link} data-id={item.id} src={item.img} class=" bg-blue-950 rounded-full p-6 w-10 h-10 flex flex-col items-center justify-center popup-videos">
                              <i class="fa fa-play text-white text-xl" data-pdf={item.link} data-id={item.id} src={item.img}></i>
                          </a>
                      </div>
                  </div>
                ))}
               </div>
            </div>

            <div class="w-full flex flex-col items-center justify-center">
                <div class=" lg:w-3/4 w-full flex flex-col items-center justify-center ">
                  <div class="lg:pt-10" >
                    <h2 class="lg:text-3xl text-2xl font-bold text-blue-900 text-start lg:pb-6 pb-1">Food Technologies with a Brand Design</h2>
                  </div>

                  <div class="text-justify">
                    <p>Kerala Startup Mission, through its 'Branding Challenge,' created Brand Designs 
                        for selected Food Technologies developed by R&D institutions in India.
                        Explore the Food Technologies with a Brand Design
                    </p>
                  </div>
                </div>
            </div>
        </div>
    </div>
</div>


<link rel="stylesheet" href="/flipbook/css/compressed.css" type="text/css">
<link rel="stylesheet" href="./flipbook/css/main.css" type="text/css">

<script src="https://code.jquery.com/jquery-3.6.0.min.js" is:inline></script>
<script src="/flipbook/js/compressed.js" is:inline></script>
<script src="/flipbook/js/pdf.combined.min.js" is:inline></script>
<script src="/flipbook/js/flipbook.min.js" is:inline></script>


<script type="text/javascript" src="./flipbook/js/compressed.js" is:inline></script>
<script type="text/javascript" src="./flipbook/js/pdf.combined.min.js" is:inline></script>
<script type="text/javascript" src="./flipbook/js/flipbook.min.js" is:inline></script>

<script is:inline>
    function fullscreenErrorHandler() {
      if (self != top) return "The frame is blocking full screen mode. Click on 'remove frame' button above and try to go full screen again."
    }

    function buildBook(e) {
      var item = e.target;
      var link = item.getAttribute('data-pdf');
      var id = item.getAttribute('data-id');
      console.log(link,id)

        
      var optionsBook = {
        height: 1024,
        width: 1450,
        pageNumbers: !1,
        pdf: link,
        pdfFind: !0,
        pdfTextSelectable: !0,
        lightbox: "#"+id+"-trigger",
        lightboxClass: "lightbox-pdf",
        centeredWhenClosed: !0,
        hardcovers: !0,
        curl: !0,
        curlSize: 200,
        toolbar: "lastLeft, left, currentPage, right, lastRight, toc, find, zoomin, zoomout, download, flipsound, thumbnails",
        thumbnailsPosition: "bottom",
        responsiveHandleWidth: 150,
        onFullscreenError: fullscreenErrorHandler
      
      };

      var q = '#'+id, e = $.wowBook(q); e || ($(q).wowBook(optionsBook), e = $.wowBook(q)), e.showLightbox()

    }

    var books = [].slice.call(document.querySelectorAll('[data-pdf]'));
    books.map(book => {
      book.addEventListener('click', buildBook);
    })

    //setTimeout(buildBook, 3000);
    window.contentPage = function () {
      location.hash = "#book2/3"
    };

    

    var currentHash = window.location.hash.replace(/\\#.*\\/g, "")
    window.onhashchange = function () {
      currentHash = window.location.hash.replace(/\\#.*\\/g, "")
      if (parseInt(currentHash) > 3) {
        $(".backBtn").show()
      }
      else {
        $(".backBtn").hide()
      }
    }

    $(function () {
      $(".wowbook-book-container").append("<span class='backBtn'>Back to Contents Page</span>")
      $(".backBtn").click(function () {
        location.hash = "#book2/3"
      });
    });

  </script>
